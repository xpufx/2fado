# SYSTEM (root) unit example for a future privileged layout — NOT the
# per-user service. The active user unit is etc/2fadod.service (installed by
# `make service-install` into ~/.config/systemd/user/).

[Unit]
Description=2fado privileged daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/2fado daemon
Environment=TWOFADO_CONF=/etc/2fado/2fado.conf
Restart=on-failure
# Hardening to tighten later: ProtectSystem=strict, PrivateTmp=yes, ...
NoNewPrivileges=no

[Install]
WantedBy=multi-user.target
