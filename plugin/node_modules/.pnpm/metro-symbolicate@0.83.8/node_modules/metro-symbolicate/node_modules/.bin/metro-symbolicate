#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/home/xpufx/code/2fado/plugin/node_modules/.pnpm/metro-symbolicate@0.83.8/node_modules/metro-symbolicate/node_modules:/home/xpufx/code/2fado/plugin/node_modules/.pnpm/metro-symbolicate@0.83.8/node_modules:/home/xpufx/code/2fado/plugin/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/home/xpufx/code/2fado/plugin/node_modules/.pnpm/metro-symbolicate@0.83.8/node_modules/metro-symbolicate/node_modules:/home/xpufx/code/2fado/plugin/node_modules/.pnpm/metro-symbolicate@0.83.8/node_modules:/home/xpufx/code/2fado/plugin/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../src/index.js" "$@"
else
  exec node  "$basedir/../../src/index.js" "$@"
fi
