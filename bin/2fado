#!/usr/bin/env python3
"""2fado - agent-facing client (PoC). Ships argv+cwd+env to 2fadod,
waits for the verdict, relays exit code and output."""
import json
import os
import socket
import sys

SOCK = os.environ.get("FADO_SOCKET", "/run/2fado.sock")


def call(msg):
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.connect(SOCK)
    s.sendall(json.dumps(msg).encode() + b"\n")
    buf = b""
    while not buf.endswith(b"\n"):
        chunk = s.recv(65536)
        if not chunk:
            break
        buf += chunk
    return json.loads(buf.decode())


def main(args):
    if not args or args[0] in ("-h", "--help"):
        print("usage: 2fado run -- <argv...>"
              " | 2fado approve|deny <request-id>")
        return 2
    if args[0] in ("approve", "deny") and len(args) == 2:
        print(call({"verdict": {"id": args[1], "decision": args[0]}}))
        return 0
    if args[0] == "run":
        args = args[1:]
        if args and args[0] == "--":
            args = args[1:]
    res = call({"argv": args, "cwd": os.getcwd(), "env": dict(os.environ)})
    if res.get("status") == "allowed":
        sys.stdout.write(res.get("output", ""))
        return res.get("exit", 0)
    print("2fado: denied (%s)" % res.get("reason", "?"), file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
