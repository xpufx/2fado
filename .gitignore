# Real configs live outside the repo. Never commit tokens.
2fado.conf
*.conf
!/etc/
etc/*.conf
!etc/*.example
# Built binaries stay out; `make build`.
bin/*
!bin/.gitignore
daemon.log

# Local-only tooling state.
.serena/
opencode.jsonc

# Binary / build / test artifacts.
*.tgz
*.tar.gz
node_modules/
coverage.out
*.test
*.out
*.exe
*.log

# Local secrets. Never commit.
.env*
*.pem
*.key
