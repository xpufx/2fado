# Real configs live outside the repo. Never commit tokens.
2fado.conf
*.conf
!/etc/
etc/*.conf
!etc/*.example
# Built binaries stay out; `make build`.
bin/*
!bin/.gitignore
dist/
daemon.log

# Local-only tooling state.
.serena/
opencode.jsonc

# Binary / build / test artifacts.
*.tgz
*.tar.gz
node_modules/
coverage.out
*.test
*.out
*.exe
*.log

# Go build cache redirected into the tree when ~/.cache is read-only
# (sandboxed agents); never commit it.
.gocache/
# Ad-hoc scratch dirs used for isolated daemon/test runs.
.testrun/

# Local secrets. Never commit.
.env*
*.pem
*.key
